# Javni URL stranice (koristi se za canonical, sitemap i Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.m-team.hr"

# --- Slanje kontakt forme ---------------------------------------------------
# Forma je namjerno onemogucena dok ovi podaci nisu postavljeni.
# Bez njih API ruta vraca 503 i korisniku se prikazuju mailto/tel alternative.
# Podrzan je bilo koji SMTP posluzitelj ili Resend (odaberite jedno).

# Varijanta A - Resend
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL="info@m-team.hr"

# Varijanta B - SMTP (zahtijeva dodatnu instalaciju nodemailer paketa)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
